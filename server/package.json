{
  "name": "writers-guild-server",
  "version": "1.5.1",
  "description": "Writers Guild - Novel writing application server",
  "keywords": [
    "ai",
    "deepseek",
    "novel",
    "writing"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "HOST=127.0.0.1 node --watch server.js",
    "dev:lan": "HOST=0.0.0.0 node --watch server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
